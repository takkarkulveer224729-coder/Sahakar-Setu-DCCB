# Coop Connect settings
# Copy this file to "settings.env" (same folder), change what you need, then
# restart Coop Connect (or restart the PC if it starts automatically).
# Lines starting with # are ignored.

# Port the app runs on
# PORT=3000

# Largest file people can share, in MB
# MAX_UPLOAD_MB=100

# ---- Voice & video calls ----
# Calls connect directly between devices. On some mobile-data and office networks
# that is blocked, and calls only connect through a relay ("TURN") server.
# Get TURN details from any TURN provider (several have free plans) and fill in:
# TURN_URLS=turn:your-turn-server.example.com:3478,turns:your-turn-server.example.com:443?transport=tcp
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
